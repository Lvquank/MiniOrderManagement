# Server Port
PORT=3000
NODE_ENV=development
# Local: API + worker. Set false for a separate API service.
# Vercel always disables the worker; run npm run start:worker elsewhere.
WORKER_ENABLED=true

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=mini_order_db
# Cloud: application uses the pooled URL; migrations prefer the direct URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Redis Configuration (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# Optional redis:// or rediss:// URL, takes precedence over host/port/password.
REDIS_URL=
# API and worker must use the same prefix. Use a unique prefix for tests.
QUEUE_PREFIX=bull

# Simulation Settings
SIMULATE_FAILURE_RATE=0.3
ORDER_EXPIRY_MINUTES=30
